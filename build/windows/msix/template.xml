<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="brick-wails"
        Arguments=""
        InstallLocation="C:\Program Files\RequestBite\RequestBite Brick">
    </Installer>
    <PackageInformation
        PackageName="RequestBite Brick"
        PackageDisplayName="RequestBite Brick"
        PublisherName="CN=RequestBite"
        PublisherDisplayName="RequestBite"
        Version="0.1.0.0"
        PackageDescription="Tray companion for RequestBite Brick storage sync">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.requestbite.brick"
                Description="Tray companion for RequestBite Brick storage sync"
                DisplayName="RequestBite Brick"
                ExecutableName="brick-wails"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>RequestBite Brick</DisplayName>
            <PublisherDisplayName>RequestBite</PublisherDisplayName>
            <Description>Tray companion for RequestBite Brick storage sync</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="brick-wails.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
