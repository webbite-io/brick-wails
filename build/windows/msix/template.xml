<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="brick-ui"
        Arguments=""
        InstallLocation="C:\Program Files\Webbite\Webbite Brick">
    </Installer>
    <PackageInformation
        PackageName="Webbite Brick"
        PackageDisplayName="Webbite Brick"
        PublisherName="CN=Webbite"
        PublisherDisplayName="Webbite"
        Version="0.1.0.0"
        PackageDescription="Tray companion for the Webbite Brick CLI">
        <Capabilities>
            <Capability Name="runFullTrust" />

        </Capabilities>
        <Applications>
            <Application
                Id="io.webbite.brick"
                Description="Tray companion for the Webbite Brick CLI"
                DisplayName="Webbite Brick"
                ExecutableName="brick-ui"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Webbite Brick</DisplayName>
            <PublisherDisplayName>Webbite</PublisherDisplayName>
            <Description>Tray companion for the Webbite Brick CLI</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="brick-ui.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
