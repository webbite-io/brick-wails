# Webbite Brick (desktop app) environment configuration
#
# Copy this file to .env.local for local development and fill in the values.
# Dev builds (`make dev`, `make build-dev`) load .env.local (then .env.dev) at
# startup; production builds bake these values in at compile time instead
# (`make build-prod` reads them from .env.prod, CI from real env vars) and
# never read .env files — the same rule brick-cli follows.
#
# The keys are the same as brick-cli's .env.example, plus the two web URLs.

# Accounts/auth API and Storage API.
ACC_API_URL=http://localhost:8080
STORAGE_API_URL=http://localhost:8081

# OIDC client. MUST be the same client as brick-cli's: both apps share the
# tokens in config.yaml, and a refresh token can only be refreshed by the
# client it was issued to. The callback URL is shared too (7332), so a GUI
# login and a `brick login` can't run at the same moment.
OAUTH_CLIENT_ID=
OAUTH_SCOPES=openid email profile accounts offline_access brick:manage
OAUTH_CALLBACK_URL=http://localhost:7332/auth/callback

# The OIDC client the *web app* is registered as. The tray's "Open Brick App"
# mints an authorization code for this client so the browser opens already
# signed in, and the web app redeems that code at the token endpoint as
# itself — so this must be the client id the web app exchanges with, and
# STORAGE_WEB_URL + /oauth2/callback must be a registered redirect_uri for it.
# Defaults to OAUTH_CLIENT_ID, which is right only when the web app redeems as
# this same client; a code minted for one client cannot be redeemed by
# another. When they differ, the hand-off falls back to the plain web URL and
# the reason is logged to brick-ui.log.
WEB_OAUTH_CLIENT_ID=

# Brick web app (tray "Open Brick App") and help pages.
STORAGE_WEB_URL=https://brick.webbite.io
STORAGE_HELP_URL=

# Verbose logging to stderr in addition to <config dir>/brick-ui.log.
DEBUG=false

# Dev/test only: use a different config directory instead of the one shared
# with brick-cli (~/.config/brick, or %AppData%\brick on Windows). Leave
# empty for normal use — brick-cli ignores this, so an overridden directory
# is NOT shared with the CLI.
BRICK_CONFIG_DIR=

# --- macOS releases only (`make release` on a Mac; see README.md) ---
# The Developer ID certificate to sign with, as `security find-identity -v -p
# codesigning` lists it: "Developer ID Application: <Team> (<TEAMID>)".
MAC_SIGN_IDENTITY=
# The notarytool keychain profile (xcrun notarytool store-credentials <name>).
MAC_NOTARY_PROFILE=brick-notary
# Sparkle's EdDSA public key, printed by `make sparkle-keys`. Stamped into
# Info.plist; installed copies only accept updates signed with its private key.
SPARKLE_PUBLIC_ED_KEY=
